# Anthropic (existing)
ANTHROPIC_API_KEY=

# Resend contact form (existing)
RESEND_API_KEY=
CONTACT_EMAIL=

# Vercel KV / Upstash Redis — attach a KV store to the Vercel project and
# these are set automatically. Used for server-side daily rate limiting.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Random secret used to sign the premium-access cookie (e.g. `openssl rand -hex 32`).
PREMIUM_COOKIE_SECRET=

# Stripe secret key, used by api/verify-premium.js to confirm checkout
# sessions server-side before granting premium access.
STRIPE_SECRET_KEY=

# Random secret only the site owner knows (e.g. `openssl rand -hex 32`).
# Visiting the site with ?owner_key=<this value> bypasses the daily question
# limit for testing. Leave unset to disable the bypass entirely.
OWNER_BYPASS_SECRET=
